# Merge these fields into your EXISTING backend/.env. Do not replace working team settings.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=public
ACCESS_TOKEN_SECRET=REPLACE_WITH_YOUR_LOCAL_SECRET_USED_BY_LOGIN
SESSION_SECRET=REPLACE_WITH_YOUR_LOCAL_SESSION_SECRET
PORT=5000
HOST=0.0.0.0

# Judge0: actual sandbox only; no local execution fallback.
JUDGE0_API_URL=https://YOUR_JUDGE0_HOST
# Backward-compatible alias: JUDGE0_URL
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=
LMS_EXECUTION_CONCURRENCY=20
# Enable only if your self-hosted Judge0 permits authenticated deletion.
JUDGE0_ENABLE_DELETE=false
# Optional language-ID overrides; verify against your Judge0 /languages endpoint.
JUDGE0_LANGUAGE_PYTHON=71
JUDGE0_LANGUAGE_JAVASCRIPT=63
JUDGE0_LANGUAGE_JAVA=62
JUDGE0_LANGUAGE_CPP=54

# Prefer an AWS IAM role or your approved local AWS profile for credentials.
AWS_REGION=ap-south-1
LMS_CERTIFICATE_BUCKET=YOUR_APPROVED_PRIVATE_MEDIA_BUCKET
# Aliases supported: AWS_S3_BUCKET, AWS_S3_REGION
LMS_APP_URL=https://YOUR_APP_HOST
SENDGRID_API_KEY=
FROM_EMAIL=

# Only for the optional live stress runner; keep the value on your machine.
LMS_STRESS_URL=http://127.0.0.1:5000/api/lms
LMS_STRESS_TOKEN=
# Only for an empty, dedicated integration-test database; never set to production.
LMS_TEST_DATABASE_URL=

# Day 7 branding. JSON file and image paths stay local; see deliverables/branding.example.json.
LMS_BRANDING_FILE=
LMS_REQUIRE_APPROVED_BRANDING=false
# Attendance roster export: sessionId,userId,date,status, with a documented source/environment.
LMS_ATTENDANCE_FILE=
# Scheduled reports remain disabled until approved recipients, schedule and real email are configured.
LMS_REPORTS_ENABLED=false
LMS_REPORT_RECIPIENTS=
LMS_REPORT_CADENCE=weekly
LMS_REPORT_UTC_HOUR=9
# Optional sandbox-host resource collection (requires Docker on the Judge0 host).
LMS_JUDGE0_CONTAINER=

# Day 7 isolated local baseline: empty database named patan_day7_validation on localhost.
LMS_BASELINE_DATABASE_URL=
# Real staging E2E is opt-in and sends a certificate to this existing staging learner.
LMS_E2E_ENVIRONMENT=
LMS_E2E_DATABASE_URL=
LMS_E2E_RECIPIENT=
# JSON receipt confirmed by the recipient; see the Day 7 guide.
LMS_E2E_EMAIL_RECEIPT_FILE=

# Dedicated shared secrets for trusted callback relays; never use a user JWT.
JUDGE0_CALLBACK_SECRET=
RECORDING_CALLBACK_SECRET=
