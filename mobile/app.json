{
  "expo": {
    "name": "ThinkZai Mobile",
    "slug": "thinkzai-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "thinkzai",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinkzai.mobile"
    },
    "android": {
      "package": "com.thinkzai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1020"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      "./plugins/withDownloads",
      "./plugins/withUsbPreview",
      "expo-secure-store",
      "./plugins/withAwsReview",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "159a5e9d-0a3d-48e3-9642-eff9622091a6"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
